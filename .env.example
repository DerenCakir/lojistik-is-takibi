# === Supabase bağlantısı ===
# Supabase panelinde: Project Settings → Database → Connection string

# Uygulama çalışırken kullanılan (Transaction pooler, port 6543)
DATABASE_URL="postgresql://postgres.XXXX:[ŞİFRE]@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migration / db push için (Direct connection, port 5432)
DIRECT_URL="postgresql://postgres:[ŞİFRE]@db.XXXX.supabase.co:5432/postgres"
